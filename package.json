{
  "name": "exam-guard",
  "version": "2.0.0",
  "description": "Checks exam papers for tampering by matching their SHA-256 fingerprint against a seal on Cardano.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m pytest -q tests",
    "test:e2e": "python3 tests/e2e/run_e2e.py",
    "seal": "node push_to_chain.js"
  },
  "dependencies": {
    "@meshsdk/core": "^1.9.1"
  }
}
